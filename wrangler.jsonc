// Pins the Cloudflare Workers deployment to plain static-asset serving.
// Without this file, Cloudflare's build auto-detects Astro and injects the
// @astrojs/cloudflare adapter, whose runtime /_image endpoint 404s here.
{
  "name": "portfolio",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist"
  }
}
