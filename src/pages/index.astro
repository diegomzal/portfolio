---
import { Image } from 'astro:assets';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/400-italic.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import compareLight from '../assets/compare-light.png';
import compareDark from '../assets/compare-dark.png';
import europa2026Light from '../assets/europa2026-light.png';
import europa2026Dark from '../assets/europa2026-dark.png';
import unitrackLight from '../assets/unitrack-light.png';
import unitrackDark from '../assets/unitrack-dark.png';
import yourKleos from '../assets/yourkleos.png';

const title = 'Diego Muñoz Zaldivar - Senior Software Engineer';
const description =
  'Diego Muñoz Zaldivar — senior software engineer from Lima building web applications in React and .NET.';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Diego Muñoz Zaldivar',
  jobTitle: 'Senior Software Engineer',
  url: Astro.site,
  email: 'diegomunozzal@gmail.com',
  sameAs: ['https://www.linkedin.com/in/diegomzal', 'https://github.com/diegomzal'],
};

type Project = {
  name: string;
  host: string;
  desc: string;
  /** Stack the project actually ships, verified against its source. */
  tech: string[];
  /** Light and dark captures. Omit until screenshots exist; the card renders without one. */
  img?: { light: ImageMetadata; dark: ImageMetadata };
};

const projects: Project[] = [
  {
    name: 'compare',
    host: 'compare.diegomz.com',
    img: { light: compareLight, dark: compareDark },
    desc: 'A minimal text comparer. Paste, diff, move on.',
    tech: ['React', 'TypeScript', 'Vite', 'Tailwind', 'Firebase Hosting'],
  },
  {
    name: 'europa2026',
    host: 'europa2026.diegomz.com',
    img: { light: europa2026Light, dark: europa2026Dark },
    desc: 'A calendar and itinerary for my trip across Europe this year.',
    tech: ['React', 'TypeScript', 'Vite', 'Tailwind', 'PWA', 'Firebase Hosting'],
  },
  {
    name: 'unitrack',
    host: 'unitrack.diegomz.com',
    img: { light: unitrackLight, dark: unitrackDark },
    desc: 'Application tracker for students applying to universities abroad.',
    tech: ['React', 'TypeScript', 'Express', 'Firestore', 'Cloud Run'],
  },
  {
    name: 'kleos',
    host: 'yourkleos.com',
    img: { light: yourKleos, dark: yourKleos },
    desc: 'A fun little project to rank your CV among other people, and participate in a global leaderboard.',
    tech: ['Next.js', 'FastAPI', 'PostgreSQL', 'Gemini', 'Cloud Run', 'Terraform'],
  },
];

const background = [
  {
    year: '2024 – 26',
    title: 'Senior Software Engineer',
    role: 'WTW (Extend Health)',
  },
  {
    year: '2023',
    title: '1st place, CAII Hackathon',
    role: 'Contraloría General de la República del Perú',
  },
  {
    year: '2020 – 24',
    title: 'Senior Consultant',
    role: 'EY, Integrity Risk Services',
  },
  {
    year: '2015 – 20',
    title: 'B.Sc. Systems Engineering',
    role: 'Universidad de Lima',
    note: '(1st of class)',
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbfaf7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0e0e0e" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <script is:inline>
      // Set the theme before first paint to avoid a light-mode flash.
      document.documentElement.dataset.theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <span class="loc">Lima, Peru</span>
        <button class="toggle" aria-label="Toggle theme"></button>
      </header>

      <h1 class="hi">Hi, I'm Diego.</h1>

      <p class="bio">
        I'm a senior software engineer from Lima with five years building web applications in React and
        .NET - most recently at <a class="link-accent" href="https://www.wtwco.com/" target="_blank" rel="noreferrer">WTW</a>,
        previously at <a class="link-accent" href="https://www.ey.com/" target="_blank" rel="noreferrer">EY</a>.
        Outside of work I build small tools that I actually use.
      </p>

      <section>
        <h2 class="section-label">Projects</h2>
        <ul class="projects">
          {
            projects.map((project, i) => (
              <li class="project">
                <div class="p-head">
                  <span class="arrow" aria-hidden="true">→</span>
                  <a class="p-name" href={`https://${project.host}`} target="_blank" rel="noreferrer">
                    {project.name}
                  </a>
                </div>
                <a class="p-url" href={`https://${project.host}`} target="_blank" rel="noreferrer">
                  {project.host}
                </a>
                {project.desc && <p class="p-desc">{project.desc}</p>}
                <ul class="p-tech" aria-label={`${project.name} stack`}>
                  {project.tech.map((tech) => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <a
                  class:list={['screenshot', !project.img && 'is-pending']}
                  href={`https://${project.host}`}
                  target="_blank"
                  rel="noreferrer"
                  tabindex="-1"
                >
                  {project.img ? (
                    (['light', 'dark'] as const).map((theme) => (
                      <Image
                        class={`shot-${theme}`}
                        src={project.img![theme]}
                        alt={`${project.name} screenshot`}
                        widths={[680, 1360]}
                        sizes="(max-width: 680px) 100vw, 680px"
                        loading={i === 0 ? 'eager' : 'lazy'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                      />
                    ))
                  ) : (
                    <span class="shot-tbd">Screenshot TBD</span>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="section-label">Selected background</h2>
        <ul class="cv">
          {
            background.map((item) => (
              <li>
                <span class="year">{item.year}</span>
                <span class="what">
                  {item.title} <span class="role">· {item.role}</span>{
                    item.note && <span class="note"> {item.note}</span>
                  }
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2 class="section-label">Elsewhere</h2>
        <div class="contact">
          <a href="mailto:diegomunozzal@gmail.com">diegomunozzal@gmail.com</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href="https://www.linkedin.com/in/diegomzal" target="_blank" rel="noreferrer">linkedin</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href="https://github.com/diegomzal" target="_blank" rel="noreferrer">github</a>
          <span class="sep" aria-hidden="true">·</span>
          <a href="/diego-munoz-cv.pdf" target="_blank" rel="noreferrer">cv</a>
        </div>
      </section>

      <footer class="foot">
        <span>English C1 · Spanish native</span>
        <span>Updated 2026</span>
      </footer>
    </div>

    <script>
      const root = document.documentElement;
      document.querySelector('.toggle')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      });
    </script>
  </body>
</html>
